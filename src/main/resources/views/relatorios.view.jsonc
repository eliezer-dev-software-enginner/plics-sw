                        },
                        "events": {
                          "onClick": "generate"
                        },
                        "style": {
                          "bgColor": "#176f76",
                          "textColor": "#ffffff",
                          "bold": true
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
