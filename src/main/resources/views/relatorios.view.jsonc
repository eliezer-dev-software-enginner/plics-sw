    "receitasVendas": {
      "type": "string",
      "initial": ""
    },
    "receitasPedidosPdv": {
      "type": "string",
      "initial": ""
    },
    "receitasContasRecebidas": {
      "type": "string",
      "initial": ""
    },
    "despesasCompras": {
      "type": "string",
      "initial": ""
    },
    "despesasContasPagas": {
      "type": "string",
      "initial": ""
    },
    "totalReceitas": {
      "type": "string",
      "initial": ""
    },
    "totalDespesas": {
      "type": "string",
      "initial": ""
    },
    "lucroLiquido": {
      "type": "string",
      "initial": ""
    },
    "contasReceberEmAberto": {
      "type": "string",
      "initial": ""
    },
    "contasPagarEmAberto": {
      "type": "string",
      "initial": ""
    },
    "produtosMaisVendidos": {
      "type": "string",
      "initial": ""
    },
    "produtosSemVenda": {
      "type": "string",
      "initial": ""
    },
    "produtosDevolvidos": {
      "type": "string",
      "initial": ""
    },
    "novosClientes": {
      "type": "string",
      "initial": ""
    },
    "novosFornecedores": {
      "type": "string",
      "initial": ""
    },
    "comparativo": {
      "type": "string",
      "initial": "[]"
    },
    "receitasPie": {
      "type": "string",
      "initial": "[]"
    },
    "despesasPie": {
      "type": "string",
      "initial": "[]"
    },
    "formasPagamentoPie": {
      "type": "string",
      "initial": "[]"
    },
    "dataInicio": {
      "type": "string",
      "initial": "2026-01-01"
    },
    "dataFim": {
      "type": "string",
      "initial": "2026-01-01"
    }
  },
  "view": {
    "type": "Scroll",
    "children": [
      {
        "type": "Column",
        "props": {
          "padding": 22,
          "spacing": 16,
          "fillWidth": true,
          "bgColor": "#f3f7fb"
        },
        "children": [
          {
            "type": "Container",
            "props": {
              "padding": 20,
              "fillWidth": true,
              "bgColor": "#ffffff"
            },
            "children": [
              {
                "type": "Column",
                "props": {
                  "spacing": 5
                },
                "children": [
                  {
                    "type": "Text",
                    "props": {
                      "text": "ANÁLISE / FINANÇAS"
                    },
                    "style": {
                      "fontSize": 12,
                      "textColor": "#167a80",
                      "bold": true
                    }
                  },
                  {
                    "type": "Text",
                    "props": {
                      "text": "Relatórios financeiros"
                    },
                    "style": {
                      "fontSize": 25,
                      "textColor": "#18324d",
                      "bold": true
                    }
                  },
                  {
                    "type": "Text",
                    "props": {
                      "text": "Acompanhe resultados, movimentações e indicadores do período."
                    },
                    "style": {
                      "fontSize": 13,
                      "textColor": "#53657e",
                      "bold": false
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "Container",
            "props": {
              "padding": 20,
              "fillWidth": true,
              "bgColor": "#ffffff"
            },
            "children": [
              {
                "type": "Column",
                "props": {
                  "spacing": 12
                },
                "children": [
                  {
                    "type": "Text",
                    "props": {
                      "text": "PERÍODO"
                    },
                    "style": {
                      "fontSize": 12,
                      "textColor": "#167a80",
                      "bold": true
                    }
                  },
                  {
                    "type": "Row",
                    "props": {
                      "spacing": 14
                    },
                    "children": [
                      {
                        "type": "Column",
                        "children": [
                          {
                            "type": "Text",
                            "props": {
                              "text": "Data início"
                            }
                          },
                          {
                            "type": "DatePicker",
                            "bind": {
                              "value": "dataInicio"
                            }
                          }
                        ]
                      },
                      {
                        "type": "Column",
                        "children": [
                          {
                            "type": "Text",
                            "props": {
                              "text": "Data fim"
                            }
