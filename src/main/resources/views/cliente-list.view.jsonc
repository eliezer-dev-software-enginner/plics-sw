{
  "version": 1,
  "id": "customerList",
  "states": {
    "search": {
      "type": "string",
      "initial": ""
    },
    "rows": {
      "type": "string",
      "initial": "[]"
    },
    "selected": {
      "type": "string",
      "initial": ""
    },
    "selectedItems": {
      "type": "string",
      "initial": "[]"
    },
    "hasSelection": {
      "type": "boolean",
      "initial": false
    },
    "hasSingleSelection": {
      "type": "boolean",
      "initial": false
    }
  },
  "view": {
    "type": "Column",
    "props": {
      "padding": 16,
      "spacing": 12,
      "fillWidth": true,
      "bgColor": "#f3f7fb",
      "fillHeight": true
    },
    "children": [
      {
        "type": "Text",
        "props": {
          "text": "Clientes"
        },
        "style": {
          "fontSize": 22,
          "bold": true,
          "textColor": "#18324d"
        }
      },
      {
        "type": "Input",
        "props": {
          "placeholder": "Pesquisar"
        },
        "bind": {
          "value": "search"
        }
      },
      {
        "type": "Row",
        "props": {
          "spacing": 8,
          "fillWidth": true
        },
        "children": [
          {
            "type": "Button",
            "props": {
              "text": "Novo",
              "height": 36
            },
            "events": {
              "onClick": "create"
            }
          },
          {
            "type": "Button",
            "props": {
              "text": "Editar",
              "height": 36
            },
            "events": {
              "onClick": "edit"
            },
            "style": {
              "bgColor": "#edf2f7",
              "textColor": "#263e56"
            }
          },
          {
            "type": "Button",
            "props": {
              "text": "Excluir",
              "height": 36
            },
            "events": {
              "onClick": "delete"
            },
            "style": {
              "bgColor": "#fce8e8",
              "textColor": "#a63131"
            }
          },
          {
            "type": "Button",
            "props": {
              "text": "Clonar",
              "height": 36
            },
            "events": {
              "onClick": "clone"
            },
            "style": {
              "bgColor": "#edf2f7",
              "textColor": "#263e56"
            }
          },
          {
            "type": "Button",
            "props": {
              "text": "Exportar CSV",
              "height": 36
            },
            "events": {
              "onClick": "exportCsv"
            },
            "style": {
              "bgColor": "#e8eef7",
              "textColor": "#254365"
            }
          },
          {
            "type": "Button",
            "props": {
              "text": "Exportar PDF",
              "height": 36
            },
            "events": {
              "onClick": "exportPdf"
            },
            "style": {
              "bgColor": "#e8eef7",
              "textColor": "#254365"
            }
          }
        ]
      },
      {
        "type": "Table",
        "props": {
          "columns": [
            {
              "title": "ID",
              "field": "id"
            },
            {
              "title": "Nome",
              "field": "nome"
            },
            {
              "title": "Celular/Telefone",
              "field": "telefone"
            },
            {
              "title": "Email",
              "field": "email"
            },
            {
              "title": "CPF/CNPJ",
              "field": "cpfCnpj"
            },
            {
              "title": "Data de nascimento",
              "field": "dataNascimento"
            },
            {
              "title": "Gestante",
              "field": "gestante"
            },
            {
              "title": "Data nasc. bebê",
              "field": "dataNascimentoBebe"
            },
            {
              "title": "UF",
              "field": "uf"
            },
            {
              "title": "CEP",
              "field": "cep"
            },
            {
              "title": "Cidade",
              "field": "cidade"
            },
            {
              "title": "Bairro",
              "field": "bairro"
            },
            {
              "title": "Rua",
              "field": "rua"
            },
            {
              "title": "Número",
              "field": "numero"
            },
            {
              "title": "Observação",
              "field": "observacao"
            },
            {
              "title": "Data de criação",
              "field": "dataCriacao"
            }
          ],
          "pageSize": 25,
          "horizontalScroll": true,
          "multipleSelection": true,
          "rowHeight": 42
        },
        "bind": {
          "items": "rows",
          "selected": "selected",
          "selectedItems": "selectedItems"
        },
        "events": {
          "onSelect": "select",
          "onDoubleClick": "details"
        }
      }
    ]
  }
}
