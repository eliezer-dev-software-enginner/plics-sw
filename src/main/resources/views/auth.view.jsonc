{
  "version": 1,
  "id": "auth",
  "states": {
    "login": {
      "type": "string",
      "initial": ""
    },
    "senha": {
      "type": "string",
      "initial": ""
    },
    "carregando": {
      "type": "boolean",
      "initial": true
    },
    "versao": {
      "type": "string",
      "initial": ""
    },
    "suporte": {
      "type": "string",
      "initial": ""
    }
  },
  "view": {
    "type": "Scroll",
    "children": [
      {
        "type": "Container",
        "props": {
          "bgImage": "/assets/bgAuth.jpg",
          "fillWidth": true,
          "fillHeight": true,
          "padding": 24
        },
        "children": [
          {
            "type": "Column",
            "props": {
              "alignment": "center",
              "fillWidth": true,
              "fillHeight": true,
              "spacing": 10
            },
            "children": [
              {
                "type": "Container",
                "props": {
                  "bgColor": "#ffffff",
                  "padding": 18,
                  "maxWidth": 460
                },
                "children": [
                  {
                    "type": "Column",
                    "props": {
                      "spacing": 10,
                      "fillWidth": true
                    },
                    "children": [
                      {
                        "type": "Row",
                        "props": {
                          "spacing": 12,
                          "alignment": "center"
                        },
                        "children": [
                          {
                            "type": "Image",
                            "props": {
                              "source": "/assets/app_ico.png",
                              "width": 52,
                              "height": 52
                            }
                          },
                          {
                            "type": "Column",
                            "props": {
                              "spacing": 2
                            },
                            "children": [
                              {
                                "type": "Text",
                                "props": {
                                  "text": "Plics SW"
                                },
                                "style": {
                                  "fontSize": 25,
                                  "textColor": "#18324d",
                                  "bold": true
                                }
                              },
                              {
                                "type": "Text",
                                "props": {
                                  "text": "Gestão simples para o seu negócio"
                                },
                                "style": {
                                  "fontSize": 13,
                                  "textColor": "#587087"
                                }
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "type": "Text",
                        "bind": {
                          "text": "versao"
                        },
                        "style": {
                          "fontSize": 12,
                          "textColor": "#72869b"
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "text": "Entre na sua conta"
                        },
                        "style": {
                          "fontSize": 19,
                          "textColor": "#17324d",
                          "bold": true
                        }
                      },
                      {
                        "type": "Column",
                        "props": {
                          "spacing": 6,
                          "fillWidth": true
                        },
                        "children": [
                          {
                            "type": "Text",
                            "props": {
                              "text": "Usuário"
                            },
                            "style": {
                              "fontSize": 13,
                              "textColor": "#263a54",
                              "bold": true
                            }
                          },
                          {
                            "type": "Input",
                            "props": {
                              "placeholder": "Seu usuário",
                              "width": 408,
                              "height": 42
                            },
                            "bind": {
                              "value": "login"
                            }
                          }
                        ]
                      },
                      {
                        "type": "Column",
                        "props": {
                          "spacing": 6,
                          "fillWidth": true
                        },
                        "children": [
                          {
                            "type": "Text",
                            "props": {
                              "text": "Senha"
                            },
                            "style": {
                              "fontSize": 13,
                              "textColor": "#263a54",
                              "bold": true
                            }
                          },
                          {
                            "type": "PasswordInput",
                            "props": {
                              "placeholder": "Sua senha",
                              "width": 408,
                              "height": 42
                            },
                            "bind": {
                              "value": "senha"
                            },
                            "events": {
                              "onEnter": "entrar"
                            }
                          }
                        ]
                      },
                      {
                        "type": "Button",
                        "props": {
                          "text": "Entrar",
                          "fillWidth": true,
                          "height": 44,
                          "defaultButton": true
                        },
                        "style": {
                          "bgColor": "#2563eb",
                          "textColor": "#ffffff",
                          "fontSize": 14
                        },
                        "events": {
                          "onClick": "entrar"
                        },
                        "bind": {
                          "disabled": "carregando"
                        }
                      },
                      {
                        "type": "Container",
                        "props": {
                          "bgColor": "#f1f5f9",
                          "padding": 12,
                          "width": 380
                        },
                        "children": [
                          {
                            "type": "Column",
                            "props": {
                              "spacing": 10
                            },
                            "children": [
                              {
                                "type": "Text",
                                "props": {
                                  "text": "Precisa de ajuda?"
                                },
                                "style": {
                                  "fontSize": 14,
                                  "textColor": "#263a54",
                                  "bold": true
                                }
                              },
                              {
                                "type": "Row",
                                "props": {
                                  "spacing": 12,
                                  "alignment": "center"
                                },
                                "children": [
                                  {
                                    "type": "Image",
                                    "props": {
                                      "source": "/assets/qrcode2.png",
                                      "width": 64,
                                      "height": 64
                                    }
                                  },
                                  {
                                    "type": "Column",
                                    "props": {
                                      "spacing": 5
                                    },
                                    "children": [
                                      {
                                        "type": "Text",
                                        "props": {
                                          "text": "Aponte a câmera para o QR Code e fale com nosso suporte.",
                                          "wrapWidth": 220
                                        },
                                        "style": {
                                          "fontSize": 12,
                                          "textColor": "#53657e"
                                        }
                                      },
                                      {
                                        "type": "Text",
                                        "bind": {
                                          "text": "suporte"
                                        },
                                        "style": {
                                          "fontSize": 12,
                                          "textColor": "#53657e"
                                        },
                                        "props": {
                                          "wrapWidth": 220
                                        }
                                      }
                                    ]
                                  }
                                ]
                              },
                              {
                                "type": "Row",
                                "props": {
                                  "spacing": 8,
                                  "fillWidth": true
                                },
                                "children": [
                                  {
                                    "type": "Button",
                                    "props": {
                                      "text": "WhatsApp",
                                      "fillWidth": true,
                                      "height": 40
                                    },
                                    "style": {
                                      "bgColor": "#168a54",
                                      "textColor": "#ffffff",
                                      "fontSize": 14
                                    },
                                    "events": {
                                      "onClick": "abrirSuporte"
                                    }
                                  },
                                  {
                                    "type": "Button",
                                    "props": {
                                      "text": "Site oficial",
                                      "fillWidth": true,
                                      "height": 40
                                    },
                                    "style": {
                                      "bgColor": "#e5edf7",
                                      "textColor": "#24415f",
                                      "fontSize": 14
                                    },
                                    "events": {
                                      "onClick": "abrirSite"
                                    }
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
