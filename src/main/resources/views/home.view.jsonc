{
  "version": 1,
  "id": "home",
  "states": {
    "receitas": {
      "type": "string",
      "initial": "R$ 0,00"
    },
    "despesas": {
      "type": "string",
      "initial": "R$ 0,00"
    },
    "lucroLiquido": {
      "type": "string",
      "initial": "R$ 0,00"
    },
    "mesAtual": {
      "type": "string",
      "initial": ""
    },
    "vendasHoje": {
      "type": "string",
      "initial": ""
    },
    "showPromo": {
      "type": "boolean",
      "initial": false
    },
    "canCheckUpdates": {
      "type": "boolean",
      "initial": true
    }
  },
  "view": {
    "type": "Scroll",
    "children": [
      {
        "type": "Container",
        "props": {
          "bgColor": "#f3f7fb",
          "fillHeight": true,
          "fillWidth": true
        },
        "children": [
          {
            "type": "Column",
            "props": {
              "padding": 24,
              "spacing": 18,
              "fillWidth": true,
              "bgColor": "#f3f7fb"
            },
            "children": [
              {
                "type": "Container",
                "props": {
                  "padding": 24,
                  "fillWidth": true,
                  "bgColor": "#ffffff"
                },
                "children": [
                  {
                    "type": "Column",
                    "props": {
                      "spacing": 12,
                      "fillWidth": true
                    },
                    "children": [
                      {
                        "type": "Text",
                        "props": {
                          "text": "PAINEL DE CONTROLE"
                        },
                        "style": {
                          "fontSize": 12,
                          "textColor": "#167a80",
                          "bold": true
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "text": "Bem-vindo ao Plics SW"
                        },
                        "style": {
                          "fontSize": 27,
                          "textColor": "#18324d",
                          "bold": true
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "text": "Acompanhe o desempenho e acesse as rotinas do seu negócio."
                        },
                        "style": {
                          "fontSize": 14,
                          "textColor": "#53657e",
                          "bold": false
                        }
                      },
                      {
                        "type": "Text",
                        "bind": {
                          "text": "mesAtual"
                        },
                        "style": {
                          "fontSize": 14,
                          "textColor": "#47647c",
                          "bold": false
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "type": "Row",
                "props": {
                  "spacing": 12,
                  "fillWidth": true
                },
                "children": [
                  {
                    "type": "Container",
                    "props": {
                      "padding": 18,
                      "fillWidth": true,
                      "bgColor": "#e9f5f2"
                    },
                    "children": [
                      {
                        "type": "Column",
                        "props": {
                          "spacing": 8
                        },
                        "children": [
                          {
                            "type": "Text",
                            "props": {
                              "text": "Receitas do mês"
                            },
                            "style": {
                              "fontSize": 13,
                              "bold": true,
                              "textColor": "#53657e"
                            }
                          },
                          {
                            "type": "Text",
                            "bind": {
                              "text": "receitas"
                            },
                            "style": {
                              "fontSize": 23,
                              "bold": true,
                              "textColor": "#18324d"
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "Container",
                    "props": {
                      "padding": 18,
                      "fillWidth": true,
                      "bgColor": "#eef3fb"
                    },
                    "children": [
                      {
                        "type": "Column",
                        "props": {
                          "spacing": 8
                        },
                        "children": [
                          {
                            "type": "Text",
                            "props": {
                              "text": "Despesas do mês"
                            },
                            "style": {
                              "fontSize": 13,
                              "bold": true,
                              "textColor": "#53657e"
                            }
                          },
                          {
                            "type": "Text",
                            "bind": {
                              "text": "despesas"
                            },
                            "style": {
                              "fontSize": 23,
                              "bold": true,
                              "textColor": "#18324d"
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "Container",
                    "props": {
                      "padding": 18,
                      "fillWidth": true,
                      "bgColor": "#eaf2fc"
                    },
                    "children": [
                      {
                        "type": "Column",
                        "props": {
                          "spacing": 8
                        },
                        "children": [
                          {
                            "type": "Text",
                            "props": {
                              "text": "Lucro líquido"
                            },
                            "style": {
                              "fontSize": 13,
                              "bold": true,
                              "textColor": "#53657e"
                            }
                          },
                          {
                            "type": "Text",
                            "bind": {
                              "text": "lucroLiquido"
                            },
                            "style": {
                              "fontSize": 23,
                              "bold": true,
                              "textColor": "#18324d"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "Container",
                "props": {
                  "padding": 14,
                  "fillWidth": true,
                  "bgColor": "#ffffff"
                },
                "children": [
                  {
                    "type": "Column",
                    "props": {
                      "spacing": 12,
                      "fillWidth": true
                    },
                    "children": [
                      {
                        "type": "Text",
                        "bind": {
                          "text": "vendasHoje"
                        },
                        "style": {
                          "fontSize": 14,
                          "textColor": "#47647c"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "type": "Container",
                "props": {
                  "padding": 20,
                  "fillWidth": true,
                  "bgColor": "#ffffff"
                },
                "children": [
                  {
                    "type": "Column",
                    "props": {
                      "spacing": 12,
                      "fillWidth": true
                    },
                    "children": [
                      {
                        "type": "Text",
                        "props": {
                          "text": "Acesso rápido"
                        },
                        "style": {
                          "fontSize": 18,
                          "textColor": "#18324d",
                          "bold": true
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "text": "As tarefas mais usadas, sempre à mão."
                        },
                        "style": {
                          "fontSize": 13,
                          "textColor": "#53657e",
                          "bold": false
                        }
                      },
                      {
                        "type": "Row",
                        "props": {
                          "spacing": 10,
                          "fillWidth": true
                        },
                        "children": [
                          {
                            "type": "Button",
                            "props": {
                              "text": "Venda",
                              "fillWidth": true,
                              "iconSource": "/assets/venda.png",
                              "iconSize": 24,
                              "height": 54
                            },
                            "events": {
                              "onClick": "sales"
                            },
                            "style": {
                              "bgColor": "#e7f0f8",
                              "textColor": "#183f60",
                              "bold": true
                            }
                          },
                          {
                            "type": "Button",
                            "props": {
                              "text": "Produtos",
                              "fillWidth": true,
                              "iconSource": "/assets/produtos.png",
                              "iconSize": 24,
                              "height": 54
                            },
                            "events": {
                              "onClick": "products"
                            },
                            "style": {
                              "bgColor": "#e7f0f8",
                              "textColor": "#183f60",
                              "bold": true
                            }
                          },
                          {
                            "type": "Button",
                            "props": {
                              "text": "Clientes",
                              "fillWidth": true,
                              "iconSource": "/assets/clientes.png",
                              "iconSize": 24,
                              "height": 54
                            },
                            "events": {
                              "onClick": "customers"
                            },
                            "style": {
                              "bgColor": "#e7f0f8",
                              "textColor": "#183f60",
                              "bold": true
                            }
                          },
                          {
                            "type": "Button",
                            "props": {
                              "text": "Contas a receber",
                              "fillWidth": true,
                              "iconSource": "/assets/contas_a_receber.png",
                              "iconSize": 24,
                              "height": 54
                            },
                            "events": {
                              "onClick": "receivables"
                            },
                            "style": {
                              "bgColor": "#e7f0f8",
                              "textColor": "#183f60",
                              "bold": true
                            }
                          }
                        ]
                      },
                      {
                        "type": "Row",
                        "props": {
                          "spacing": 10,
                          "fillWidth": true
                        },
                        "children": [
                          {
                            "type": "Button",
                            "props": {
                              "text": "PDV",
                              "fillWidth": true,
                              "iconSource": "/assets/pdv.png",
                              "iconSize": 24,
                              "height": 54
                            },
                            "events": {
                              "onClick": "pos"
                            },
                            "style": {
                              "bgColor": "#e7f0f8",
                              "textColor": "#183f60",
                              "bold": true
                            }
                          },
                          {
                            "type": "Button",
                            "props": {
                              "text": "Categorias",
                              "fillWidth": true,
                              "iconSource": "/assets/categoria.png",
                              "iconSize": 24,
                              "height": 54
                            },
                            "events": {
                              "onClick": "categories"
                            },
                            "style": {
                              "bgColor": "#e7f0f8",
                              "textColor": "#183f60",
                              "bold": true
                            }
                          },
                          {
                            "type": "Button",
                            "props": {
                              "text": "Fornecedores",
                              "fillWidth": true,
                              "iconSource": "/assets/fornecedores.png",
                              "iconSize": 24,
                              "height": 54
                            },
                            "events": {
                              "onClick": "suppliers"
                            },
                            "style": {
                              "bgColor": "#e7f0f8",
                              "textColor": "#183f60",
                              "bold": true
                            }
                          },
                          {
                            "type": "Button",
                            "props": {
                              "text": "Histórico do caixa",
                              "fillWidth": true,
                              "iconSource": "/assets/abertura.png",
                              "iconSize": 24,
                              "height": 54
                            },
                            "events": {
                              "onClick": "orders"
                            },
                            "style": {
                              "bgColor": "#e7f0f8",
                              "textColor": "#183f60",
                              "bold": true
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "Container",
                "props": {
                  "padding": 20,
                  "fillWidth": true,
                  "bgColor": "#ffffff"
                },
                "children": [
                  {
                    "type": "Column",
                    "props": {
                      "spacing": 12,
                      "fillWidth": true
                    },
                    "children": [
                      {
                        "type": "Text",
                        "props": {
                          "text": "Gerencial e suporte"
                        },
                        "style": {
                          "fontSize": 18,
                          "textColor": "#18324d",
                          "bold": true
                        }
                      },
                      {
                        "type": "Row",
                        "props": {
                          "spacing": 10,
                          "fillWidth": true
                        },
                        "children": [
                          {
                            "type": "Button",
                            "props": {
                              "text": "Empresa",
                              "fillWidth": true,
                              "height": 42
                            },
                            "events": {
                              "onClick": "company"
                            },
                            "style": {
                              "bgColor": "#edf2f7",
                              "textColor": "#183f60",
                              "bold": false
                            }
                          },
                          {
                            "type": "Button",
                            "props": {
                              "text": "Relatórios",
                              "fillWidth": true,
                              "height": 42
                            },
                            "events": {
                              "onClick": "reports"
                            },
                            "style": {
                              "bgColor": "#edf2f7",
                              "textColor": "#183f60",
                              "bold": false
                            }
                          },
                          {
                            "type": "Button",
                            "props": {
                              "text": "Preferências",
                              "fillWidth": true,
                              "height": 42
                            },
                            "events": {
                              "onClick": "preferences"
                            },
                            "style": {
                              "bgColor": "#edf2f7",
                              "textColor": "#183f60",
                              "bold": false
                            }
                          },
                          {
                            "type": "Button",
                            "props": {
                              "text": "Sugerir melhoria",
                              "fillWidth": true,
                              "height": 42
                            },
                            "events": {
                              "onClick": "feedback"
                            },
                            "style": {
                              "bgColor": "#edf2f7",
                              "textColor": "#183f60",
                              "bold": false
                            }
                          }
                        ]
                      },
                      {
                        "type": "Row",
                        "props": {
                          "spacing": 10,
                          "fillWidth": true
                        },
                        "children": [
                          {
                            "type": "Button",
                            "props": {
                              "text": "Novidades",
                              "fillWidth": true,
                              "height": 42
                            },
                            "events": {
                              "onClick": "updates"
                            },
                            "style": {
                              "bgColor": "#edf2f7",
                              "textColor": "#183f60",
                              "bold": false
                            }
                          },
                          {
                            "type": "Button",
                            "props": {
                              "text": "Logs",
                              "fillWidth": true,
                              "height": 42
                            },
                            "events": {
                              "onClick": "logs"
                            },
                            "style": {
                              "bgColor": "#edf2f7",
                              "textColor": "#183f60",
                              "bold": false
                            }
                          },
                          {
                            "type": "Button",
                            "props": {
                              "text": "Termos de uso",
                              "fillWidth": true,
                              "height": 42
                            },
                            "events": {
                              "onClick": "terms"
                            },
                            "style": {
                              "bgColor": "#edf2f7",
                              "textColor": "#183f60",
                              "bold": false
                            }
                          },
                          {
                            "type": "Button",
                            "props": {
                              "text": "Buscar atualização",
                              "fillWidth": true,
                              "height": 42
                            },
                            "events": {
                              "onClick": "checkUpdates"
                            },
                            "bind": {
                              "visible": "canCheckUpdates"
                            },
                            "style": {
                              "bgColor": "#edf2f7",
                              "textColor": "#183f60",
                              "bold": false
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "Container",
                "props": {
                  "padding": 18,
                  "fillWidth": true,
                  "bgColor": "#e9f5f2"
                },
                "bind": {
                  "visible": "showPromo"
                },
                "children": [
                  {
                    "type": "Column",
                    "props": {
                      "spacing": 10
                    },
                    "children": [
                      {
                        "type": "Text",
                        "props": {
                          "text": "Impulsione seu Instagram!"
                        },
                        "style": {
                          "bold": true
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "text": "Conheça os pacotes de divulgação."
                        }
                      },
                      {
                        "type": "Button",
                        "props": {
                          "text": "Comprar agora",
                          "fillWidth": true
                        },
                        "events": {
                          "onClick": "buyInstagram"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "type": "Row",
                "props": {
                  "spacing": 10
                },
                "children": [
                  {
                    "type": "Button",
                    "props": {
                      "text": "Canal de vídeos",
                      "fillWidth": true
                    },
                    "events": {
                      "onClick": "videos"
                    },
                    "style": {
                      "bgColor": "#edf2f7",
                      "textColor": "#254365"
                    }
                  },
                  {
                    "type": "Button",
                    "props": {
                      "text": "Serviços para Instagram",
                      "fillWidth": true
                    },
                    "events": {
                      "onClick": "instagram"
                    },
                    "style": {
                      "bgColor": "#edf2f7",
                      "textColor": "#254365"
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
